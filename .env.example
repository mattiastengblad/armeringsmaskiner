# Public site URL, used for sitemap/robots/canonical/OG tags
NEXT_PUBLIC_SITE_URL=https://armeringsmaskiner.se

# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string used by Drizzle (Project Settings -> Database -> Connection string, "Transaction" pooler for serverless)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Resend (transactional email)
RESEND_API_KEY=re_your_api_key
ORDER_NOTIFICATION_EMAIL=per.lindgren@armeringsmaskiner.se
